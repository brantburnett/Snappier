{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "./Snappier",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "output": "api",
      "properties": {
        "TargetFramework": "net11.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "artifacts/**",
          "**/BenchmarkDotNet.Artifacts/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "artifacts/_site",
    "template": [
      "default",
      "material/material",
      "templates/snappier"
    ],
    "globalMetadata": {
      "_appName": "Snappier",
      "_appTitle": "Snappier",
      "_appLogoPath": "images/icon-48.png",
      "_gitContribute": {
        "repo": "https://github.com/brantburnett/Snappier",
        "branch": "main"
      },
      "_enableSearch": true,
      "pdf": false
    },
    "postProcessors": ["ExtractSearchIndex"]
  }
}
