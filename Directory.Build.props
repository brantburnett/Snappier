<Project>
  <PropertyGroup>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <!--
    BenchmarkDotNet generates BenchmarkDotNet.Autogenerated.csproj under the artifacts folder. Its
    ImportDirectoryBuildProps=false is set too late to take effect, so it still imports this file.
    Its generated code isn't written for the updated memory safety rules and fails with CS9377.
  -->
  <PropertyGroup Condition=" '$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated' ">
    <!-- preview is required for the updated memory safety rules, which are not part of C# 15 by default -->
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
  </PropertyGroup>
</Project>
